<?xml version="1.0"?>
<sdf version="1.6">
  <world name="lidar_test_world">
    <light name="sun_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.1 -0.9</direction>
    </light>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <model name="room_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>20 20 0.1</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>20 20 0.1</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
        <pose>0 0 -0.05 0 0 0</pose>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <pose>0 10 0.8 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>20 0.2 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.2 1.6</size></box></geometry>
          <material><ambient>0.85 0.84 0.8 1</ambient><diffuse>0.85 0.84 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>0 -10 0.8 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>20 0.2 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20 0.2 1.6</size></box></geometry>
          <material><ambient>0.85 0.84 0.8 1</ambient><diffuse>0.85 0.84 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>10 0 0.8 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>0.2 20 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 20 1.6</size></box></geometry>
          <material><ambient>0.85 0.84 0.8 1</ambient><diffuse>0.85 0.84 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-10 0 0.8 0 0 0</pose>
      <link name="wall_link">
        <collision name="collision"><geometry><box><size>0.2 20 1.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 20 1.6</size></box></geometry>
          <material><ambient>0.85 0.84 0.8 1</ambient><diffuse>0.85 0.84 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>


    <!-- TESTOWE OBIEKTY DLA SZTUCZNEJ INTELIGENCJI YOLO -->
    <!-- Wirtualna Zielona Butelka na ziemi dla YOLO klasa 39 (zastępuje piłkę) -->
    <model name="green_beer_bottle">
      <static>false</static>
      <!-- Położenie na ziemi przed wózkiem -->
      <pose>1.0 1.0 0.0 0 0 0</pose>
      <link name="link">

        <!-- Cześć główna butelki (grubszy walec korpusowy) -->
        <collision name="base_collision">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.2</length></cylinder></geometry>
        </collision>
        <visual name="base_visual">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.2</length></cylinder></geometry>
          <material>
            <!-- Szklista, ciemna, chmielowa Zieleń dla datasetu COCO -->
            <ambient>0.05 0.5 0.1 0.8</ambient>
            <diffuse>0.05 0.5 0.1 0.8</diffuse>
            <specular>0.1 0.9 0.2 0.8</specular>
          </material>
        </visual>

        <!-- Szyjka butelki (cieńszy walec) -->
        <collision name="neck_collision">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.1</length></cylinder></geometry>
        </collision>
        <visual name="neck_visual">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.1</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.5 0.1 0.8</ambient>
            <diffuse>0.05 0.5 0.1 0.8</diffuse>
          </material>
        </visual>

        <!-- Środek ciężkości (nieodłączny dla złożonych obiektów fizycznych dynamicznych - unika przenikalności Gazebo w dno) -->
        <inertial>
          <mass>0.4</mass>
          <pose>0 0 0.1 0 0 0</pose>
          <inertia>
            <ixx>0.001</ixx> <iyy>0.001</iyy> <izz>0.001</izz>
          </inertia>
        </inertial>

      </link>
    </model>
    <!-- ============================================== -->
    <!-- WIRTUALNA PIŁKA TURNIEJOWA (Baza OpenRobotics) -->
    <!-- ============================================== -->

    <!-- Wyśmienity model piłki gotowy i oteksturowany siatkami (Klasa 32 COCO: Sports Ball) -->
    <!-- Ściągany przez Ignition Gazebo z chmury OpenRobotics bez błędu 404 -->
    <include>
      <pose>8 4 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/RoboCup%203D%20Simulation%20Ball</uri>
      <scale>10 10 10</scale>
    </include>

  </world>
</sdf>
