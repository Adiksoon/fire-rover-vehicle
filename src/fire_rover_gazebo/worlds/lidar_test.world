<?xml version="1.0"?>
<sdf version="1.6">
  <world name="lidar_test_world">
    <light name="sun_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.1 -0.9</direction>
    </light>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <model name="room_floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box>
              <size>12 12 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="floor_visual">
          <geometry>
            <box>
              <size>12 12 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
        <pose>0 0 -0.05 0 0 0</pose>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>12 0.2 1.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12 0.2 1.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.84 0.8 1</ambient>
            <diffuse>0.85 0.84 0.8 1</diffuse>
          </material>
        </visual>
        <pose>0 6 0.8 0 0 0</pose>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>12 0.2 1.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12 0.2 1.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.84 0.8 1</ambient>
            <diffuse>0.85 0.84 0.8 1</diffuse>
          </material>
        </visual>
        <pose>0 -6 0.8 0 0 0</pose>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 12 1.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 12 1.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.84 0.8 1</ambient>
            <diffuse>0.85 0.84 0.8 1</diffuse>
          </material>
        </visual>
        <pose>6 0 0.8 0 0 0</pose>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 12 1.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 12 1.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.84 0.8 1</ambient>
            <diffuse>0.85 0.84 0.8 1</diffuse>
          </material>
        </visual>
        <pose>-6 0 0.8 0 0 0</pose>
      </link>
    </model>

    <model name="center_box">
      <static>true</static>
      <pose>2.2 0.8 0.5 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.1 0.9 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.1 0.9 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.55 0.75 1</ambient>
            <diffuse>0.3 0.55 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="low_box">
      <static>true</static>
      <pose>-1.8 2.4 0.3 0 0 -0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.6 0.8 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.6 0.8 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.45 0.22 1</ambient>
            <diffuse>0.75 0.45 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="round_column">
      <static>true</static>
      <pose>-2.6 -1.7 0.7 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>1.4</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.45</radius>
              <length>1.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.22 0.68 0.38 1</ambient>
            <diffuse>0.22 0.68 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="storage_pillar">
      <static>true</static>
      <pose>3.4 -2.8 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.8 1.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.8 1.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.32 0.68 1</ambient>
            <diffuse>0.55 0.32 0.68 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
